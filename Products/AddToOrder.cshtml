@model EmployeeCrudPdf.Models.AddToOrderViewModel
@{
    ViewData["Title"] = "Add to Order";
}

<h3>Add to Order</h3>
<hr />

<form asp-action="AddToOrder" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />

    <div class="col-12">
        <label class="form-label">Product</label>
        <input class="form-control" value="@Model.ProductName" readonly />
    </div>

    <div class="col-md-4">
        <label asp-for="Qty" class="form-label"></label>
        <input asp-for="Qty" class="form-control" type="number" min="1" />
        <span asp-validation-for="Qty" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label class="form-label">Add to existing order (optional)</label>
        <select asp-for="OrderId" class="form-select">
            <option value="">-- Create New Order --</option>
            @foreach (var o in Model.RecentOrders)
            {
                <option value="@o.Id">@o.Id - @o.OrderNo</option>
            }
        </select>
        <span class="form-text">Leave blank to create a new order.</span>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Add</button>
        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
